# ==========================================
# TYGRIS Prototype - Git Ignore Rules
# Tracks only the working prototype (frontend-v2, backend, docs, scripts)
# Excludes raw datasets, model weights, and legacy/experimental folders
# ==========================================

# Runtime-captured sighting photos (saved by routes_identify.py's
# _record_sighting) — grows unbounded as the app is used, unlike the
# curated seed DB, so it isn't tracked.
/backend/data/captures/

# Datasets & Heavy Experiments (Kept locally on disk, excluded from Git)
# NOTE: Download and place the appropriate dataset folder (e.g. PTR_Tiger_IDs_2025/)
# on the respective local device / drive. Do not commit heavy imagery to git.
/PTR_Tiger_IDs_2025/
/PTR_Tiger_IDs_2025*/
/Dataset/
*.xlsx
/ntlnp_raw/
/final_data/
/detectiontest/
/detectiontrainval/
/posetrain/
/poseval/
/reid_raw/
/tiger_trace/
/tygris-research-model/
/tygris-synthetic/
/ui inspo/
/frontend/

# Internal raw datasets inside identification & detection
/identification/data/
/identification/api_log.txt
/detection/data/images/
/detection/data/labels/
/detection/runs/predict/
/detection/runs/tiger_yolov8n/weights/last.pt

# Large Model Weights & Checkpoints (>100MB hard limit on GitHub)
*.h5
*.keras
*.weights.h5
*.pt
*.pth
*.onnx
*.pkl
*.bin
*.tflite
/resnet50_model.h5
/resnet50_model.keras
/resnet50_model_weights.weights.h5
/efficientnetb3_notop.h5

# Whitelist trained production models
!/identification/models/tiger_embedding_finetuned.weights.h5
!/detection/runs/tiger_yolov8n/weights/best.pt

# Root duplicate PDF & notebook
/1-s2.0-S1470160X25001566-main.pdf
/klasifikasi-gambar.ipynb

# Local ML working artifacts (raw datasets, venvs, checkpoints, logs)
/Dataset/
backend/.venv312/
backend/checkpoints/
backend/logs/
# SQLite databases are generated locally from data scripts — do not commit
backend/data/*.db
backend/data/*.sqlite

# Environment & Secrets (NEVER COMMIT SENSITIVE KEYS)
.env
.env.*
*.env
.env.local
.env.*.local
*.pem
*.key

